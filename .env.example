# Copy to .env (gitignored) and fill in real values.
# Used by docker-compose.yml's gemini-bridge service (see
# docs/roadmap/phases/phase-quant-gemini-bridge.md) and by the backend's
# Martin Luk review "Nhờ AI nhận xét" button (phase-luk-review.md).
# Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional: Gemini model for the Martin Luk review.
GEMINI_MODEL=gemini-2.5-flash

# Optional, used by deploy.sh -- per-service "Deploy Hook" URLs from Render.
RENDER_DEPLOY_HOOK_BACKEND=
RENDER_DEPLOY_HOOK_FRONTEND=
