# Copy to .env (never commit .env)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-key
IMAGE_TAG=latest
MARKET_DATA_SOURCE=vci
# true when the AI server is the "ai" service / a private address;
# false if you point Settings at a public https AI endpoint.
QUANT_ALLOW_PRIVATE_ENDPOINTS=true
